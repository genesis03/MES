# Oracle Cloud / production example
# 실제 배포 서버에서는 반드시 긴 랜덤값으로 변경하세요.
SECRET_KEY=change-this-to-a-long-random-secret

# 신규 DB에서만 초기 계정 생성 시 사용됩니다.
DEFAULT_ADMIN_PASSWORD=change-admin-password
DEFAULT_USER_PASSWORD=change-user-password

# Docker 컨테이너 내부 영구 SQLite 경로
DATABASE_URL=sqlite:////data/manual_labels.db

# 외부 공개 포트. Nginx를 앞단에 둘 경우 127.0.0.1 바인딩을 권장합니다.
MES_BIND_IP=0.0.0.0
MES_BIND_PORT=8080
